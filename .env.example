# Development only. Set a local password before starting Compose.
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=
AI_PROVIDER=deterministic
# Stage 2 report generation. Deterministic is explicitly NOT LLM inference.
AEGIS_LLM_PROVIDER=deterministic
# To opt in to a separately installed local Ollama model, use provider=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Runtime uses a pre-provisioned model cache; it never downloads embeddings.
EMBEDDING_CACHE_DIR=.model-cache
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
