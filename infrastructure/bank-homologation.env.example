# Configuration template only; never put credentials in this file.
# Load real values through your deployment secret manager.
ASPNETCORE_ENVIRONMENT=Homologation
Security__Enabled=true
Security__Authority=
Security__Audience=
Security__Workspace=
AiRuntime__BaseUrl=
AiRuntime__ServiceToken=
AEGIS_ENVIRONMENT=Homologation
AEGIS_SECURITY_ENABLED=true
AEGIS_SERVICE_TOKEN=
# Gateway and runtime service tokens must match. Use a random ASCII secret >=32 characters.
# Corporate issuer must supply sub, aegis_workspace and repeated aegis_permission claims.
# Permissions: knowledge.read, knowledge.write, execution.read, execution.run,
# execution.approve, execution.cancel, tools.read.
# Bank demo permissions: bank.customer.read, bank.analysis.run.
# Dedicated workspace only: these permissions do NOT isolate individual customers.
# Runtime is private; expose only the gateway via TLS. MCP uses local stdio.
# Angular corporate sign-in and authenticated SSE integration are still required.
# Code not built or tested: deployment and real customer data are not authorized by this template.
